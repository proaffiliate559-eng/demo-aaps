# ─────────────────────────────────────────────────────────────
# StyleMood AI — environment variables
# Copy to .env.local (never commit .env.local).
# NEXT_PUBLIC_* values are exposed to the browser. Everything else is server-only.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API). For local dev run `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY — bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the app — used for auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" only after enabling the Google provider in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ── AI (server only) ─────────────────────────────────────────
# gemini = real AI. mock = clearly labelled development placeholders (blocked in Vercel production).
AI_PROVIDER=gemini
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Comma-separated models tried in order when the main one is busy/unavailable.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
# Stylist chat messages per user per day.
CHAT_DAILY_LIMIT=40
# Outfit inspiration images (Mode A). Needs billing enabled on your Google AI account.
IMAGE_PROVIDER=none           # none | gemini
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# IMAGE_DAILY_LIMIT=5
# ── Payments: Razorpay (server only) ─────────────────────────
# Leave empty to keep upgrades disabled ("Payments launching soon").
# Dashboard → Account & Settings → API Keys (use rzp_test_… keys first).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → URL https://YOUR_DOMAIN/api/payments/webhook,
# events: payment.captured, order.paid, payment.failed. Paste the secret here.
RAZORPAY_WEBHOOK_SECRET=
