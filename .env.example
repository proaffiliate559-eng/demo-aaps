# Copy to .env.local and fill in. Never commit real values.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used by cron jobs. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public URL of this app (used inside printed QR codes). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Random 32+ char secret for signing customer QR tokens: `openssl rand -base64 48`
QR_TOKEN_SECRET=change-me-to-a-long-random-string
# Secret that Vercel Cron (or your scheduler) sends as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=change-me-too

# --- Later milestones (not used yet; leave empty) ---
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# AI_API_KEY=

# Local DB tests (supabase start prints this)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
