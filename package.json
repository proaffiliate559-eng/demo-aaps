{
  "name": "caferepeat-ai",
  "version": "0.2.0",
  "private": true,
  "description": "Multi-tenant customer loyalty SaaS for Indian cafes and restaurants",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "db:reset": "supabase db reset",
