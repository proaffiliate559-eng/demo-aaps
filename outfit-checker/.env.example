# Copy to .env  (cp .env.example .env) — .env is never committed.

# Google Gemini API key: https://aistudio.google.com/apikey
# Realistic try-on photos need an image model, which needs billing enabled on your Google AI account.
GEMINI_API_KEY=

# Text model(s) for outfit check, comma-separated: first is main, rest are fallbacks.
GEMINI_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite
# Image model that edits the user's photo (try-on).
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# mock = demo without any API key (clearly labelled fake results). Leave empty for real AI.
AI_MODE=

PORT=3000
# Requests allowed per IP per hour (a try-on photo counts as 2).
RATE_LIMIT_PER_HOUR=30
